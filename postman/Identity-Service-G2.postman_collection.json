    "description": "Colección de pruebas de contrato para el servicio de Identidad, Usuarios y Sesiones (Grupo 2). Las pruebas validan códigos de estado, esquema de respuesta y encadenan tokens automáticamente. Importa también el environment `Identity-Service-G2.postman_environment.json` o usa la variable de colección `base_url`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "admin_access_token", "value": "" },
    { "key": "reg_email", "value": "" },
    { "key": "new_user_id", "value": "" },
    { "key": "customer_user_id", "value": "3d9a1f44-1b2a-4c3d-8e5f-aabbccddeeff" },
    { "key": "reset_token", "value": "" }
