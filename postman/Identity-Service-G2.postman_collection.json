      "name": "Auth",
      "item": [
        {
          "name": "Registro (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('reg_email', `test_${Date.now()}@correo.cl`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('devuelve user + tokens', () => {",
                  "  pm.expect(b).to.have.property('access_token');",
                  "  pm.expect(b).to.have.property('refresh_token');",
                  "  pm.expect(b.token_type).to.eql('bearer');",
                  "  pm.expect(b.user).to.have.property('user_id');",
                  "  pm.expect(b.user).to.have.property('business_user_id');",
                  "  pm.expect(b.user.role).to.eql('customer');",
                  "  pm.expect(b.user.status).to.eql('active');",
                  "});",
                  "pm.collectionVariables.set('access_token', b.access_token);",
                  "pm.collectionVariables.set('refresh_token', b.refresh_token);",
                  "pm.collectionVariables.set('new_user_id', b.user.user_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{reg_email}}\",\n  \"password\": \"MiClave123\",\n  \"full_name\": \"Usuario de Prueba\"\n}"
            }
          }
        },
