# ===========================================================================
# Identity Service (G2) - Variables de entorno
# Copia este archivo a `.env`. El mock corre sin tocar nada; estas variables
# solo sirven para personalizarlo.
# ===========================================================================

# Puerto del servidor (el contrato usa 8080 en local).
PORT=8080

# Entorno: development | production
NODE_ENV=development

# Secreto para firmar los JWT. En producción usa uno largo y aleatorio.
JWT_SECRET=secreto-de-prueba

# Vida del access token en segundos (3600 = 1h).
# Ponlo bajo (ej. 10) para demostrar la EXPIRACIÓN del token en /auth/validate.
ACCESS_TOKEN_TTL=3600

# --- Supabase (opcional, para el día que conecten el backend real) ----------
# Ver README -> "Conectar Supabase".
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
