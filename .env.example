# ===========================================================================
# Identity Service (G2) - Variables de entorno obligatorias y opcionales
# Copia este archivo a `.env` y rellena los valores.
# ===========================================================================

# Puerto del servidor (default: 8080).
PORT=8080

# Entorno: development | production
NODE_ENV=development

# --- OBLIGATORIAS -----------------------------------------------------------
# Secreto para firmar los JWT. DEBE ser un string largo y aleatorio.
# En local puedes usar cualquier valor; en producción, genera uno seguro.
JWT_SECRET=secreto-de-prueba-local

# --- SUPABASE (OBLIGATORIAS) ------------------------------------------------
# URL de tu proyecto Supabase (ej: https://abc123.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key (usa esta, NO la anon key, para operaciones de backend).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- OPCIONALES -------------------------------------------------------------
# Vida del access token en segundos (3600 = 1h).
# Ponlo bajo (ej. 10) para probar expiración en /auth/validate.
ACCESS_TOKEN_TTL=3600
